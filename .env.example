# Copy this file to .env at the repository root and fill in your credentials.
# Backend only — never use an EXPO_PUBLIC_ prefix for these keys.
# https://graphhopper.com/dashboard/
GRAPHHOPPER_API_KEY=
# https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=

# Public browser credentials: included in the app, not secrets.
# https://account.mapbox.com/access-tokens/ — public token starting with pk.
EXPO_PUBLIC_MAPBOX_TOKEN=
# https://shademap.app/ — your ShadeMap browser API key.
EXPO_PUBLIC_SHADEMAP_KEY=

# iOS Simulator on this Mac:
EXPO_PUBLIC_API_URL=http://127.0.0.1:8001
# iPhone: change only the address above to your Mac's current Wi-Fi IP.
# Keep port 8001; the phone and Mac must be able to reach each other.
# Standard Android emulator: http://10.0.2.2:8001
